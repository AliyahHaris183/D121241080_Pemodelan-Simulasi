# ======================================================================
# 1. FUNGSI INTI SIMULASI
# ======================================================================

def monte_carlo_pi_quarter(N, seed=SEED):
    """
    Estimasi Pi dengan pendekatan quarter-circle pada domain [0,1] x [0,1].

    Returns
    -------
    pi_hat      : float
        Estimasi nilai Pi.

    N_in        : int
        Jumlah titik yang jatuh di dalam quarter circle.

    exec_time   : float
        Waktu eksekusi (detik).

    x, y        : np.ndarray
        Koordinat seluruh titik.

    inside_mask : np.ndarray (bool)
        True jika titik di dalam quarter circle.
    """

    np.random.seed(seed)

    start_time = time.time()

    x = np.random.uniform(0.0, 1.0, N)
    y = np.random.uniform(0.0, 1.0, N)

    inside_mask = (x**2 + y**2) <= 1.0

    N_in = int(np.sum(inside_mask))

    pi_hat = 4.0 * (N_in / N)

    exec_time = time.time() - start_time

    return pi_hat, N_in, exec_time, x, y, inside_mask


# ======================================================================
# 2. VISUALISASI 1: SEBARAN TITIK (SCATTER PLOT)
# ======================================================================

def plot_scatter(
    x,
    y,
    inside_mask,
    N,
    pi_hat,
    filename,
    max_points_shown=20_000
):
    fig, ax = plt.subplots(figsize=(6, 6))

    if N > max_points_shown:

        idx = np.random.RandomState(0).choice(
            N,
            max_points_shown,
            replace=False
        )

        x_p = x[idx]
        y_p = y[idx]
        in_p = inside_mask[idx]

        note = f" (ditampilkan sampel {max_points_shown:,} dari {N:,} titik)"

    else:

        x_p = x
        y_p = y
        in_p = inside_mask

        note = ""

    # Titik di dalam
    ax.scatter(
        x_p[in_p],
        y_p[in_p],
        color="royalblue",
        s=3,
        label="Di dalam quarter circle"
    )

    # Titik di luar
    ax.scatter(
        x_p[~in_p],
        y_p[~in_p],
        color="crimson",
        s=3,
        label="Di luar quarter circle"
    )

    # Busur quarter circle
    theta = np.linspace(0, np.pi / 2, 200)

    ax.plot(
        np.cos(theta),
        np.sin(theta),
        color="black",
        linewidth=1.5,
        linestyle="--",
        label="Busur x²+y²=1"
    )

    ax.set_xlim(-0.02, 1.02)
    ax.set_ylim(-0.02, 1.02)

    ax.set_aspect("equal")

    ax.set_xlabel("x")
    ax.set_ylabel("y")

    ax.set_title(
        f"Sebaran Titik Monte Carlo (Quarter Circle)\n"
        f"N = {N:,} | π̂ = {pi_hat:.6f}{note}",
        fontsize=10
    )

    ax.legend(
        loc="lower left",
        fontsize=8
    )

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        OUT_DIR / f"scatter_{N}.png"
    )

    return fig


# ======================================================================
# 3. VISUALISASI 2: KONVERGENSI PI_HAT vs N
# ======================================================================

def plot_convergence(sizes, estimates, filename):

    fig, ax = plt.subplots(figsize=(8, 5))

    ax.plot(
        sizes,
        estimates,
        marker="o",
        color="royalblue",
        label="π̂ (estimasi)"
    )

    ax.axhline(
        TRUE_PI,
        color="crimson",
        linestyle="--",
        label=f"π sebenarnya = {TRUE_PI:.6f}"
    )

    ax.fill_between(
        sizes,
        TRUE_PI - 0.02,
        TRUE_PI + 0.02,
        color="crimson",
        alpha=0.07
    )

    ax.set_xscale("log")

    ax.set_xlabel("N (skala logaritmik)")
    ax.set_ylabel("Estimasi π")

    ax.set_title(
        "Konvergensi Estimasi π terhadap N — Metode Quarter Circle"
    )

    ax.legend()

    ax.grid(alpha=0.3)

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        filename
    )

    return fig


# ======================================================================
# 4. VISUALISASI 3: ERROR (%) vs N
# ======================================================================

def plot_error(sizes, errors, filename):

    sizes = np.array(sizes, dtype=float)
    errors = np.array(errors, dtype=float)

    # Garis referensi teoritis O(1/sqrt(N))
    # dinormalisasi agar mulai dari titik pertama data aktual
    ref = errors[0] * np.sqrt(
        sizes[0] / sizes
    )

    fig, ax = plt.subplots(figsize=(8, 5))

    ax.plot(
        sizes,
        errors,
        marker="s",
        color="darkorange",
        label="Error aktual (%)"
    )

    ax.plot(
        sizes,
        ref,
        linestyle=":",
        color="gray",
        label="Referensi laju teoritis O(1/√N)"
    )

    ax.set_xscale("log")
    ax.set_yscale("log")

    ax.set_xlabel("N (skala logaritmik)")

    ax.set_ylabel(
        "Error absolut (%) - skala logaritmik"
    )

    ax.set_title(
        "Penurunan Error (Galat) terhadap N — Metode Quarter Circle"
    )

    ax.legend()

    ax.grid(
        alpha=0.3,
        which="both"
    )

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        filename
    )

    return fig


# ======================================================================
# 5. VISUALISASI 4: WAKTU EKSEKUSI vs N
# ======================================================================

def plot_execution_time(sizes, times, filename):

    fig, ax = plt.subplots(figsize=(8, 5))

    ax.plot(
        sizes,
        np.array(times) * 1000,
        marker="^",
        color="seagreen"
    )

    ax.set_xscale("log")
    ax.set_yscale("log")

    ax.set_xlabel("N (skala logaritmik)")

    ax.set_ylabel(
        "Waktu eksekusi (milidetik) - skala logaritmik"
    )

    ax.set_title(
        "Waktu Eksekusi vs Jumlah Sampel N"
    )

    ax.grid(
        alpha=0.3,
        which="both"
    )

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        filename
    )

    return fig


# ======================================================================
# 6. VISUALISASI 5: PROPORSI TITIK DI DALAM
# ======================================================================

def plot_proportion_bar(sample_sizes, n_inside_list, filename):

    proportions = [
        n_in / n
        for n_in, n in zip(
            n_inside_list,
            sample_sizes
        )
    ]

    theoretical = np.pi / 4

    fig, ax = plt.subplots(figsize=(7, 5))

    labels = [
        f"N={n:,}"
        for n in sample_sizes
    ]

    bars = ax.bar(
        labels,
        proportions,
        color="royalblue",
        alpha=0.8,
        label="Proporsi aktual (N_in/N)"
    )

    ax.axhline(
        theoretical,
        color="crimson",
        linestyle="--",
        label=f"Proporsi teoritis (π/4 = {theoretical:.6f})"
    )

    for bar, p in zip(
        bars,
        proportions
    ):

        ax.text(
            bar.get_x() + bar.get_width() / 2,
            p + 0.002,
            f"{p:.5f}",
            ha="center",
            fontsize=9
        )

    ax.set_ylim(
        0.75,
        0.82
    )

    ax.set_ylabel(
        "Proporsi titik di dalam quarter circle"
    )

    ax.set_title(
        "Proporsi Titik Aktual vs Nilai Teoritis (π/4)"
    )

    ax.legend()

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        filename
    )

    return fig


# ======================================================================
# 7. TABEL RINGKASAN SEBAGAI VISUALISASI
# ======================================================================

def plot_summary_table(df, filename):

    fig, ax = plt.subplots(
        figsize=(10, 1.8 + 0.5 * len(df))
    )

    ax.axis("off")

    tbl = ax.table(
        cellText=df.values,
        colLabels=df.columns,
        loc="center",
        cellLoc="center"
    )

    tbl.auto_set_font_size(False)

    tbl.set_fontsize(10)

    tbl.scale(
        1,
        1.8
    )

    for j in range(len(df.columns)):

        tbl[0, j].set_facecolor("#1F2937")

        tbl[0, j].set_text_props(
            color="white",
            fontweight="bold"
        )

    plt.tight_layout()

    save_figure_if_enabled(
        fig,
        filename
    )

    return fig


