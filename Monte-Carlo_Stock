def find_data_csv():
    """
    Mencari CSV data historis AAPL secara otomatis di folder pemsim.

    Urutan:
        1. AAPL_yahoo_finance.csv jika ada.
        2. CSV lain yang memiliki kolom Date dan Close.
        3. Jika ada beberapa CSV yang cocok, dipakai yang paling baru.
    """
    if not DATA_DIR.exists():
        raise FileNotFoundError(
            "Folder data CSV tidak ditemukan.\n"
            f"Folder yang dicek: {DATA_DIR}\n"
            "Pastikan folder /Users/aliyahharis/Desktop/pemsim ada."
        )

    preferred = DATA_DIR / "AAPL_yahoo_finance.csv"
    if preferred.exists():
        return preferred

    candidates = sorted(
        DATA_DIR.rglob("*.csv"),
        key=lambda p: p.stat().st_mtime,
        reverse=True
    )

    valid = []
    for csv_path in candidates:
        try:
            header = pd.read_csv(csv_path, nrows=0)
            columns = {str(c).strip().lower() for c in header.columns}
            if "date" in columns and "close" in columns:
                valid.append(csv_path)
        except Exception:
            continue

    if valid:
        print(f"[info] Memakai file CSV yang ditemukan otomatis: {valid[0]}")
        return valid[0]

    raise FileNotFoundError(
        "Tidak ada file CSV dengan kolom Date dan Close yang ditemukan.\n"
        f"Folder yang dicek: {DATA_DIR}\n"
        "Pastikan CSV harga historis AAPL ada di folder tersebut."
    )


def get_historical_prices(csv_path=None):
    """
    Membaca data harga historis RIIL saham AAPL dari CSV Yahoo Finance.
    Kolom Date dan Close dibaca, lalu data diurutkan berdasarkan tanggal.
    """
    if csv_path is None:
        csv_path = find_data_csv()

    df = pd.read_csv(csv_path)
    df.columns = [str(c).strip() for c in df.columns]

    # Samakan nama kolom secara sederhana agar "date"/"close" tetap terbaca.
    column_map = {c.lower(): c for c in df.columns}
    date_col = column_map.get("date")
    close_col = column_map.get("close")

    if date_col is None or close_col is None:
        raise ValueError(
            f"CSV {csv_path.name} harus memiliki kolom 'Date' dan 'Close'. "
            f"Kolom yang ditemukan: {list(df.columns)}"
        )

    df[date_col] = pd.to_datetime(df[date_col], errors="coerce")
    df[close_col] = pd.to_numeric(df[close_col], errors="coerce")

    df = df.dropna(subset=[date_col, close_col])
    df = df.sort_values(date_col).reset_index(drop=True)

    prices = df[close_col].to_numpy(dtype=float)
    dates = df[date_col].to_numpy()

    if len(prices) < 2:
        raise ValueError("Data historis harus memiliki minimal 2 baris harga penutupan.")

    if np.any(prices <= 0):
        raise ValueError("Semua harga Close harus bernilai positif untuk perhitungan log-return.")

    return prices, dates


def compute_drift_volatility(prices):
    """
    Menghitung drift (mu) dan volatilitas (sigma) TAHUNAN dari
    deret harga historis, menggunakan log-return harian.
    """
    log_returns = np.diff(np.log(prices))
    mu_daily = np.mean(log_returns)
    sigma_daily = np.std(log_returns, ddof=1)

    mu_annual = mu_daily * TRADING_DAYS
    sigma_annual = sigma_daily * np.sqrt(TRADING_DAYS)
    return mu_annual, sigma_annual, log_returns


def simulate_gbm_paths(s0, mu, sigma, n_days, n_simulations):
    """
    Simulasi Monte Carlo multi-path untuk harga saham memakai GBM.

    Returns
    -------
    paths : np.ndarray, shape (n_simulations, n_days+1)
    """
    dt = 1 / TRADING_DAYS
    z = np.random.normal(0, 1, size=(n_simulations, n_days))
    daily_returns = (mu - 0.5 * sigma**2) * dt + sigma * np.sqrt(dt) * z
    log_paths = np.cumsum(daily_returns, axis=1)
    paths = s0 * np.exp(log_paths)
    paths = np.hstack([np.full((n_simulations, 1), s0), paths])
    return paths


def add_download_button(fig, default_filename):
    """
    Menambahkan tombol "Download PNG" pada setiap grafik.
    Klik tombol untuk memilih lokasi penyimpanan; menutup grafik berarti
    grafik tidak perlu disimpan.
    """
    button_ax = fig.add_axes([0.78, 0.01, 0.18, 0.055])
    save_button = Button(button_ax, "Download PNG")

    def save_figure(_event):
        try:
            import tkinter as tk
            from tkinter import filedialog

            root = tk.Tk()
            root.withdraw()
            root.attributes("-topmost", True)

            output_path = filedialog.asksaveasfilename(
                title="Simpan grafik",
                initialfile=default_filename,
                initialdir=str(Path.home() / "Downloads"),
                defaultextension=".png",
                filetypes=[("PNG image", "*.png")]
            )
            root.destroy()

            if output_path:
                # Sembunyikan tombol sementara agar hasil PNG hanya berisi grafik.
                button_ax.set_visible(False)
                fig.canvas.draw_idle()
                fig.savefig(output_path, dpi=300, bbox_inches="tight")
                button_ax.set_visible(True)
                fig.canvas.draw_idle()
                print(f"[saved] Grafik disimpan: {output_path}")
        except Exception as exc:
            print(f"[warning] Grafik tidak berhasil disimpan melalui dialog: {exc}")

    save_button.on_clicked(save_figure)
    # Keep a persistent reference so the button callback remains alive.
    if not hasattr(fig, "_download_buttons"):
        fig._download_buttons = []
    fig._download_buttons.append(save_button)


def plot_historical(prices, dates):
    fig, ax = plt.subplots(figsize=(9, 4.5))
    ax.plot(dates, prices, color="black", linewidth=1.2)
    ax.set_title(f"Harga Historis Riil Saham {TICKER}\n"
                 f"({pd.Timestamp(dates[0]).strftime('%d %b %Y')} - "
                 f"{pd.Timestamp(dates[-1]).strftime('%d %b %Y')}, sumber: Yahoo Finance)")
    ax.set_xlabel("Tanggal")
    ax.set_ylabel("Harga penutupan (USD)")
    ax.grid(alpha=0.3)
    fig.autofmt_xdate()
    fig.subplots_adjust(bottom=0.18)
    add_download_button(fig, "stock_historical.png")
    return fig


def plot_paths(paths, n_show=200):
    fig, ax = plt.subplots(figsize=(9, 5.5))
    idx = np.random.choice(paths.shape[0], min(n_show, paths.shape[0]), replace=False)
    for i in idx:
        ax.plot(paths[i], linewidth=0.6, alpha=0.35)
    mean_path = paths.mean(axis=0)
    ax.plot(mean_path, color="black", linewidth=2.2, label="Rata-rata semua simulasi")
    ax.set_title(f"Simulasi Monte Carlo Harga Saham {TICKER}\n"
                 f"({paths.shape[0]:,} lintasan, horizon {paths.shape[1]-1} hari)")
    ax.set_xlabel("Hari ke depan")
    ax.set_ylabel("Harga saham (USD)")
    ax.legend()
    ax.grid(alpha=0.3)
    fig.subplots_adjust(bottom=0.14)
    add_download_button(fig, "stock_paths_30d.png")
    return fig


def plot_final_distribution(final_prices, s0, day_label):
    fig, ax = plt.subplots(figsize=(8, 5))
    ax.hist(final_prices, bins=60, color="royalblue", alpha=0.75, edgecolor="white")
    mean_p = np.mean(final_prices)
    p5, p50, p95 = np.percentile(final_prices, [5, 50, 95])
    ax.axvline(mean_p, color="crimson", linestyle="--", linewidth=2,
               label=f"Mean = {mean_p:.2f}")
    ax.axvline(s0, color="black", linestyle=":", linewidth=2,
               label=f"Harga awal = {s0:.2f}")
    ax.axvline(p5, color="darkorange", linestyle="-.", linewidth=1.5,
               label=f"5th percentile = {p5:.2f}")
    ax.axvline(p95, color="darkorange", linestyle="-.", linewidth=1.5,
               label=f"95th percentile = {p95:.2f}")
    ax.set_title(f"Distribusi Harga Saham Setelah {day_label} Hari\n"
                 f"(hasil {len(final_prices):,} simulasi Monte Carlo)")
    ax.set_xlabel("Harga saham (USD)")
    ax.set_ylabel("Frekuensi")
    ax.legend(fontsize=8)
    ax.grid(alpha=0.3)
    fig.subplots_adjust(bottom=0.16)

    filename = f"stock_dist_{day_label}d.png"
    add_download_button(fig, filename)
    return fig


